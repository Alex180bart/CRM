{
  "name": "crm-cf",
  "private": true,
  "version": "0.1.0",
  "description": "CRM Omnichannel da Contabilidade Facilitada — atendimento, automação e inteligência artificial",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --ext .ts,.tsx,.js,.cjs,.mjs --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,md,json,css}\"",
    "clean": "turbo run clean",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "^2.5.0",
    "typescript": "~5.7.3",
    "vitest": "^4"
  }
}
